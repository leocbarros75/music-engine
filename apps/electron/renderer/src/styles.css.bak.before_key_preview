@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=Spectral:wght@400;600&display=swap");

:root {
  color-scheme: light;
  --bg: #f4efe7;
  --panel: #ffffff;
  --panel-muted: #f9f6f1;
  --ink: #1f2b2f;
  --muted: rgba(31, 43, 47, 0.62);
  --accent: #df6b3f;
  --accent-2: #0f6f68;
  --border: rgba(31, 43, 47, 0.12);
  --warn: #c58b2c;
  --error: #b5442c;
  --shadow: 0 18px 40px rgba(35, 28, 20, 0.15);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Space Grotesk", "Avenir Next", sans-serif;
  color: var(--ink);
  background:
    radial-gradient(1200px 600px at 85% -20%, rgba(15, 111, 104, 0.16), transparent 60%),
    radial-gradient(700px 500px at 10% 110%, rgba(223, 107, 63, 0.16), transparent 60%),
    linear-gradient(140deg, #f9f4ec, #efe7dc 45%, #e9e2d5);
  min-height: 100vh;
}

h1,
h2,
h3 {
  font-family: "Spectral", "Georgia", serif;
  margin: 0 0 0.4rem;
}

p {
  margin: 0;
  color: var(--muted);
}

.app {
  padding: 24px;
}

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 20px;
}

.server-pill {
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 0.85rem;
  border: 1px solid var(--border);
  background: var(--panel);
  box-shadow: var(--shadow);
}

.server-pill.ready {
  border-color: rgba(15, 111, 104, 0.4);
  color: var(--accent-2);
}

.server-pill.pending {
  border-color: rgba(223, 107, 63, 0.4);
  color: var(--accent);
}

.app-grid {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr) 360px;
  grid-template-areas:
    "settings input output"
    "settings logs output";
  gap: 18px;
}

.panel {
  background: var(--panel);
  border-radius: 18px;
  padding: 18px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.panel.settings {
  grid-area: settings;
}

.panel.input {
  grid-area: input;
}

.panel.output {
  grid-area: output;
}

.panel.logs {
  grid-area: logs;
}

.settings-form {
  display: grid;
  gap: 12px;
}

.key-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px 12px;
  align-items: center;
}

.key-grid label {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
}

.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

label {
  font-size: 0.85rem;
  color: var(--muted);
}

input,
select,
textarea {
  border-radius: 10px;
  border: 1px solid var(--border);
  padding: 10px 12px;
  font-size: 0.9rem;
  font-family: inherit;
  background: var(--panel-muted);
  color: var(--ink);
}

textarea {
  min-height: 120px;
  resize: vertical;
}

.upload-card {
  background: var(--panel-muted);
  border-radius: 14px;
  padding: 16px;
  border: 1px dashed rgba(31, 43, 47, 0.2);
  display: grid;
  gap: 12px;
}

.file-meta {
  display: flex;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--muted);
}

.file-meta .label {
  font-weight: 600;
  color: var(--ink);
}

.file-path {
  font-size: 0.78rem;
  color: var(--muted);
  word-break: break-all;
}

.prompt-block {
  margin-top: 18px;
}

.prompt-assistant {
  margin-top: 18px;
  background: var(--panel-muted);
  border-radius: 16px;
  padding: 16px;
  border: 1px solid rgba(15, 111, 104, 0.18);
}

.prompt-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.prompt-header h3 {
  margin-bottom: 0.2rem;
}

.prompt-suggestion {
  font-size: 0.9rem;
  line-height: 1.4;
  color: var(--ink);
}

.summary-grid {
  display: grid;
  gap: 12px;
  font-size: 0.9rem;
}

.summary-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.action-row {
  margin-top: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.result-card {
  margin-top: 18px;
  background: var(--panel-muted);
  border-radius: 16px;
  padding: 14px;
  border: 1px solid var(--border);
}

.result-grid {
  display: grid;
  gap: 10px;
  font-size: 0.88rem;
}

.result-actions {
  margin-top: 8px;
}

.path {
  word-break: break-all;
  font-size: 0.82rem;
}

button {
  border-radius: 10px;
  border: 1px solid rgba(31, 43, 47, 0.2);
  padding: 10px 14px;
  font-size: 0.9rem;
  font-family: inherit;
  cursor: pointer;
  background: #fff;
  color: var(--ink);
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}

button:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 18px rgba(31, 43, 47, 0.12);
}

button.primary {
  background: linear-gradient(120deg, #df6b3f, #e68e57);
  border: none;
  color: #fff;
}

button.ghost {
  background: transparent;
  border: 1px solid rgba(15, 111, 104, 0.4);
  color: var(--accent-2);
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  box-shadow: none;
}

.pill {
  margin-top: 6px;
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.75rem;
  border: 1px solid var(--border);
  background: #fff;
}

.pill.warn {
  border-color: rgba(197, 139, 44, 0.4);
  color: var(--warn);
}

.logs-panel {
  display: grid;
  gap: 16px;
}

.logs-header h3 {
  margin-bottom: 0.2rem;
}

.warning-list {
  background: #fff7ea;
  border: 1px solid rgba(197, 139, 44, 0.3);
  border-radius: 12px;
  padding: 12px;
  display: grid;
  gap: 8px;
}

.warning-item {
  display: flex;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--ink);
}

.badge {
  text-transform: uppercase;
  font-size: 0.7rem;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 6px;
  border: 1px solid rgba(31, 43, 47, 0.2);
}

.badge.warn {
  color: var(--warn);
  border-color: rgba(197, 139, 44, 0.4);
}

.log-stream {
  background: var(--panel-muted);
  border-radius: 12px;
  padding: 12px;
  border: 1px solid var(--border);
  font-size: 0.78rem;
  display: grid;
  gap: 6px;
  max-height: 320px;
  overflow-y: auto;
}

.log-line {
  display: grid;
  grid-template-columns: 60px 60px 1fr;
  gap: 10px;
  align-items: baseline;
}

.log-time {
  color: var(--muted);
}

.log-level {
  text-transform: uppercase;
  font-size: 0.7rem;
  font-weight: 600;
}

.log-line.warn .log-level {
  color: var(--warn);
}

.log-line.error .log-level {
  color: var(--error);
}

.muted {
  color: var(--muted);
  font-size: 0.85rem;
}

@media (max-width: 1200px) {
  .app-grid {
    grid-template-columns: 1fr;
    grid-template-areas:
      "settings"
      "input"
      "output"
      "logs";
  }

  .key-grid {
    grid-template-columns: 1fr;
  }
}
