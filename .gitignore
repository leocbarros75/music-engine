# ---- OS / editor ----
.DS_Store
**/.DS_Store
Thumbs.db

# ---- dependencies / builds ----
node_modules/
dist/
*.tsbuildinfo

# ---- logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---- backups / temp ----
*.bak
*.backup
*.tmp
*.swp
*.swo

# If you intentionally keep these in-repo, delete these lines
src/**/.DS_Store
tests/**/.DS_Store

# ---- test artifacts / outputs ----
out_*.musicxml
*.musicxml~

# ---- misc ----
.env
.env.*

# Local test scripts and editor config
_diag_*.ts
_test_*.ts
.claude/launch.json

# ---- reference material in outputs/ ----
# outputs/ holds external comparison scores (Codex Astra arrangements, the
# string bowing lab) used as benchmarks, NOT engine output. Each folder also
# ships a zip and a nested copy of its own contents; those are byte-identical
# duplicates, so only the canonical files are tracked.
outputs/**/*.zip
outputs/string-bowing-lab/string-bowing-lab/
outputs/test4-strings/test4-string-ensemble/
outputs/last-train-strings/last-train-strings/
outputs/living-hope-piano-and-strings/living-hope-piano-and-strings/
outputs/o-espirito-piano/o-espirito-piano-complete/
outputs/living-hope-wind-quartet/living-hope-wind-quartet/
# An .mxl is a zip under another extension, and its score.xml is the same music
# as the .musicxml extracted beside it — 2,081 notes either way. The PDFs are
# what engrave-jobs.json regenerates from that MusicXML, so they are the
# derived artifact rather than the canonical one. Both stay on disk.
outputs/**/*.mxl
outputs/**/*.pdf
# Python bytecode from running the reference generators.
__pycache__/
*.pyc
