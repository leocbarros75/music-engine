import fs from "node:fs";
import process from "node:process";

import { parseMusicXMLToScoreModel } from "../../src/parsers/musicxmlParser";
import { analyzeHarmony } from "../../src/harmony/analyzeHarmony";

type Granularity = "beat" | "measure";

function usage(): never {
  console.error("Usage: tsx tests/harmony/runHarmonyTest.ts <path-to-xml> [beat|measure]");
  process.exit(1);
}

const filePath = process.argv[2];
const granularity = (process.argv[3] === "measure" || process.argv[3] === "beat")
  ? (process.argv[3] as Granularity)
  : ("beat" as Granularity);

if (!filePath) usage();

if (!fs.existsSync(filePath)) {
  console.error(`File not found: ${filePath}`);
  process.exit(1);
}

const xml = fs.readFileSync(filePath, "utf8");
const scoreModel = parseMusicXMLToScoreModel(xml);

const out = analyzeHarmony({
  scoreModel,
  options: {
    granularity,
    ignorePercussion: true
  }
} as any);

console.log(JSON.stringify(out, null, 2));
