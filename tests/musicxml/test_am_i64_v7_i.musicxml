      <note>
        <chord/>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>16</duration>
        <type>whole</type>
      </note>
    </measure>

    <measure number="2">
      <!-- V7 in A minor: E7 = E G# B D (bass E) -->
      <note>
        <pitch><step>E</step><octave>4</octave></pitch>
        <duration>16</duration>
        <type>whole</type>
      </note>
      <note>
