{
  "name": "music-engine",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test:harmony": "node --import tsx tests/run-tests.mjs harmony",
    "test:harmony:beat": "node --import tsx tests/run-tests.mjs harmony beat",
    "test:harmony:measure": "node --import tsx tests/run-tests.mjs harmony measure",
    "app": "npm --prefix apps/electron run dev",
    "app:install": "npm --prefix apps/electron install",
    "web": "npm --prefix apps/web run dev",
    "web:install": "npm --prefix apps/web install",
    "test:score": "node --import tsx tests/score/scoreStandard.test.ts",
    "test:preservation": "node --import tsx tests/preservation/sourcePreservation.test.ts && node --import tsx tests/preservation/serverPreservation.test.ts",
    "test:performance": "node --import tsx tests/performance/performance.test.ts",
    "test": "node --import tsx tests/run-tests.mjs",
    "test:arrange": "node --import tsx tests/run-tests.mjs arrange",
    "test:musicxml": "node --import tsx tests/run-tests.mjs musicxml",
    "test:application": "node --import tsx tests/application/applicationPaths.test.ts",
    "test:phrases": "node --import tsx tests/ai/phraseCollaboration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@xmldom/xmldom": "^0.8.11",
    "fast-xml-parser": "^5.3.4",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  }
}
