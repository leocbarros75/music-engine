{
  "name": "music-engine",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test:harmony": "bash tests/harmony/runHarmonyTests.sh",
    "test:harmony:beat": "bash tests/harmony/runHarmonyTests.sh beat",
    "test:harmony:measure": "bash tests/harmony/runHarmonyTests.sh measure",
    "app": "npm --prefix apps/electron run dev",
    "app:install": "npm --prefix apps/electron install",
    "web": "npm --prefix apps/web run dev",
    "web:install": "npm --prefix apps/web install"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "fast-xml-parser": "^5.3.4",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  }
}
