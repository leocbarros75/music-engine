// src/arrange/mapToEnsemble.ts
import type { ScoreModel } from "../score/types";
import { InstrumentCatalog, shiftOctavesIntoRange, midiToPitch, pitchToMidi } from "../instruments/instrumentCatalog";
import { extractOnsetChords } from "../analyze/chordExtractor";

type NoteEvent = any;

function makePart(part_id: string, name: string, instrument: string, staves = 1) {
  return {
    part_id,
    name,
    instrument,
    staves,
    measures: [] as any[]
  };
}

function cloneMeasureShell(m: any) {
  return {
    number: m.number,
    attributes: { ...m.attributes },
    events: [] as any[]
  };
}

function addNote(measure: any, t: number, dur: number, pitch: { step: string; alter?: number; octave: number }, voice: number, staff: number) {
  const id = `EV_${measure.number}_${t}_${staff}_${voice}_${Math.random().toString(16).slice(2, 10)}`;
  measure.events.push({
    id,
    t,
    dur,
    type: "note",
    pitch: { step: pitch.step, alter: pitch.alter, octave: pitch.octave },
    voice,
    staff
  });
}

function addRest(measure: any, t: number, dur: number, voice: number, staff: number) {
  const id = `REST_${measure.number}_${t}_${staff}_${voice}_${Math.random().toString(16).slice(2, 10)}`;
  measure.events.push({
    id,
    t,
    dur,
    type: "rest",
    voice,
    staff
  });
}

export function mapPianoToStringQuartetOpen(score: ScoreModel): ScoreModel {
  // Target parts
  const v1 = makePart("V1", "Violin I", "violin", 1);
  const v2 = makePart("V2", "Violin II", "violin", 1);
  const va = makePart("VA", "Viola", "viola", 1);
  const vc = makePart("VC", "Cello", "cello", 1);

  const partsOut = [v1, v2, va, vc];

  // Build measure shells from first part’s measures (assumes piano-like single part input)
  const srcPart = score.parts[0];
  const measureMap: Record<string, any> = {};
  for (const m of srcPart.measures) {
    const shells = partsOut.map(() => cloneMeasureShell(m));
    measureMap[String(m.number)] = shells;

    v1.measures.push(shells[0]);
    v2.measures.push(shells[1]);
    va.measures.push(shells[2]);
    vc.measures.push(shells[3]);
  }

  // Chords at each onset
  const chords = extractOnsetChords(score);

  // We need durations at each onset. Minimal rule:
  // - Use the max duration among notes at that onset; if none, skip.
  // - This is enough for testing. Later you can preserve individual dur/voices.
  for (const ch of chords) {
    const mNum = ch.measure;
    const mShells = measureMap[String(mNum)];
    if (!mShells) continue;

    const notes = ch.notes.slice().sort((a, b) => a.midi - b.midi);
    if (notes.length === 0) continue;

    const t = ch.t;
    const dur = Math.max(...notes.map(n => (n as any).dur ?? 480), 1); // fallback

    // Pick outer voices
    let low = notes[0];
    let high = notes[notes.length - 1];

    // Remove duplicates for inner selection
    const inner = notes.slice(1, Math.max(1, notes.length - 1));

    // Choose inner voices (if available)
    let midLow = inner.length > 0 ? inner[0] : null;
    let midHigh = inner.length > 1 ? inner[inner.length - 1] : null;

    // If only 2 notes total, double the inner by octave placement (simple)
    if (!midLow && notes.length >= 2) midLow = notes[0];
    if (!midHigh && notes.length >= 2) midHigh = notes[1] ?? notes[0];

    // Convert to midi we can move around
    let mV1 = high.midi;
    let mVC = low.midi;
    let mVA = midLow ? midLow.midi : low.midi;
    let mV2 = midHigh ? midHigh.midi : high.midi;

    // ---- Open spacing heuristics (classical quartet) ----
    // Ensure order: VC < VA < V2 < V1 (by pushing down by octaves)
    // 1) Keep V1 highest
    // 2) Push V2 below V1 if too close
    while (mV2 >= mV1 - 3) mV2 -= 12;
    // 3) Push VA below V2
    while (mVA >= mV2 - 3) mVA -= 12;
    // 4) Push VC below VA with some independence (at least a 5th)
    while (mVC >= mVA - 7) mVC -= 12;

    // Range enforcement
    const rV1 = InstrumentCatalog.violin_1;
    const rV2 = InstrumentCatalog.violin_2;
    const rVA = InstrumentCatalog.viola;
    const rVC = InstrumentCatalog.cello;

    mV1 = shiftOctavesIntoRange(mV1, rV1.midi_low, rV1.midi_high);
    mV2 = shiftOctavesIntoRange(mV2, rV2.midi_low, rV2.midi_high);
    mVA = shiftOctavesIntoRange(mVA, rVA.midi_low, rVA.midi_high);
    mVC = shiftOctavesIntoRange(mVC, rVC.midi_low, rVC.midi_high);

    // Re-check ordering after range pull; fix with gentle adjustments
    if (mV2 >= mV1) mV2 = shiftOctavesIntoRange(mV2 - 12, rV2.midi_low, rV2.midi_high);
    if (mVA >= mV2) mVA = shiftOctavesIntoRange(mVA - 12, rVA.midi_low, rVA.midi_high);
    if (mVC >= mVA) mVC = shiftOctavesIntoRange(mVC - 12, rVC.midi_low, rVC.midi_high);

    // Write notes
    const p1 = midiToPitch(mV1);
    const p2 = midiToPitch(mV2);
    const pA = midiToPitch(mVA);
    const pC = midiToPitch(mVC);

    addNote(mShells[0], t, dur, p1, 1, 1); // V1
    addNote(mShells[1], t, dur, p2, 1, 1); // V2
    addNote(mShells[2], t, dur, pA, 1, 1); // VA
    addNote(mShells[3], t, dur, pC, 1, 1); // VC
  }

  // Build final score
  return {
    score_id: `ARR_${Math.random().toString(16).slice(2, 10)}`,
    meta: { ensemble: "string_quartet" },
    global: { ...score.global },
    parts: partsOut
  } as any;
}