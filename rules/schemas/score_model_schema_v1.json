{
  "schema_version": "1.2",
  "note_event": {
    "t": "number (quarter-note beats, relative to measure start)",
    "dur": "number (quarter-note beats; >0, or 0 for grace notes)",
    "type": "note|rest",
    "pitch": {
      "step": "A-G",
      "alter": "int?",
      "octave": "int"
    },
    "voice": "int",
    "staff": "int?",
    "grace": "boolean?",
    "midi": "number? (cache in the same pitchSpace as pitch)",
    "tieStart": "boolean?",
    "tieStop": "boolean?",
    "articulations": "string[]?"
  },
  "measure": {
    "number": "int",
    "attributes": {
      "divisions": "int (MusicXML serialization resolution only)",
      "key_fifths": "int",
      "time": {
        "beats": "int",
        "beat_type": "int"
      },
      "source_divisions": "int?",
      "key_mode": "major|minor?"
    },
    "events": "note_event[]",
    "durationBeats": "number? (explicit pickup/irregular-bar length)",
    "implicit": "boolean?",
    "performance": {
      "tempos": "{t: quarter-beat offset, bpm: quarter-note BPM}[]?",
      "dynamics": "{t: quarter-beat offset, velocity: 1..127}[]?",
      "repeatStart": "boolean?",
      "repeatEnd": "int? (total passes)",
      "endings": "{numbers: int[], type: start|stop|discontinue}[]?",
      "issues": "string[]? (unsupported instructions)"
    }
  },
  "part": {
    "part_id": "string",
    "name": "string",
    "instrument": "string",
    "clef": "string",
    "staff": "int",
    "measures": "measure[]",
    "pitchSpace": "written|sounding",
    "transpose": {
      "diatonic": "int",
      "chromatic": "int",
      "octaveChange": "int"
    }
  },
  "score_model": {
    "score_id": "string",
    "meta": "object",
    "global": "object",
    "parts": "part[]",
    "harmony_timeline": "array",
    "analysis_cache": "object",
    "standardVersion": 1
  },
  "contract": "src/score/types.ts, src/score/standard.ts and src/score/performance.ts"
}
